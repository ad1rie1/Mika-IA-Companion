# Unit systemd pour le backend Mika (Django + Channels sous uvicorn).
#
# Installation (unit *utilisateur*, pas de root — la base, Chroma et les
# uploads restent au propriétaire) :
#   mkdir -p ~/.config/systemd/user
#   cp deploy/mika.service ~/.config/systemd/user/mika.service
#   # adapter WorkingDirectory et ExecStart ci-dessous
#   systemctl --user daemon-reload
#   systemctl --user enable --now mika
#   loginctl enable-linger "$USER"     # pour qu'elle tourne sans session ouverte
#   journalctl --user -u mika -f
#
# Unit système : copier dans /etc/systemd/system/, ajouter User=/Group=, et
# remplacer `systemctl --user` par `systemctl`.

[Unit]
Description=Mika — VTuber engine (backend)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Le dépôt : run.py ajoute backend/ au sys.path et lit .env à la racine.
WorkingDirectory=%h/Bureau/PROJET IA/vtuber
# Infrastructure seulement (voir .env.example) ; tout l'applicatif est dans
# le tableau de bord. `-` = ne pas échouer si le fichier manque.
EnvironmentFile=-%h/Bureau/PROJET IA/vtuber/.env
Environment=PYTHONUNBUFFERED=1
# Interpréteur du venv qui a reçu backend/requirements.txt.
ExecStart=%h/Bureau/PROJET IA/vtuber/.venv/bin/python run.py

# Arrêt : SIGTERM déclenche le lifespan shutdown d'uvicorn, dont chaque
# étape est bornée (config/asgi.py, BUDGETS_ARRET_S — 45 s au total). Cette
# borne doit rester AU-DESSUS de ce total, sinon le SIGKILL tombe pendant
# une étape, ce qui est exactement ce que le budget interne évite. Un test
# (test_arret_supervise.py) lit cette valeur et la compare au budget.
KillSignal=SIGTERM
TimeoutStopSec=60
# Code 3 = mémoire longue refusée au démarrage (MEMORY_REQUIRE_VECTOR_STORE) :
# redémarrer en boucle ne réparerait pas un dossier Chroma corrompu.
Restart=on-failure
RestartPreventExitStatus=3
RestartSec=5

# Le processus ne doit pas être tué pour mémoire avant les autres : le
# modèle d'embedding pèse ~500 Mo résident.
OOMScoreAdjust=-100

[Install]
WantedBy=default.target
