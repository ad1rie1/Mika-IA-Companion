# ============================================================================
# Authentication - Choose ONE method:
# ============================================================================

# Method 1: OAuth Token (Recommended - uses Claude.ai login)
# Get your OAuth token from Claude.ai and paste it here
CLAUDE_OAUTH_TOKEN=

# Method 2: API Key (Legacy - requires paid Anthropic API account)
ANTHROPIC_API_KEY=

# ============================================================================
# VTuber Configuration
# ============================================================================

VTUBER_NAME=Mika
CLAUDE_MODEL=claude-sonnet-4-5-20250929
CLAUDE_MODEL_LIGHT=claude-sonnet-4-5

# ============================================================================
# Multi-Provider AI (Optional)
# ============================================================================

# Additional provider API keys (only needed if you use these providers)
OPENAI_API_KEY=
OPENAI_BASE_URL=
OLLAMA_BASE_URL=http://localhost:11434

# Role → provider:model mapping
# Format: "provider:model" where provider is claude|openai|ollama
# Defaults use Claude if not set. Examples:
# AI_ROLE_CONVERSATION=claude:claude-opus-4-6
# AI_ROLE_CONVERSATION_TOOLS=claude:claude-opus-4-6
# AI_ROLE_EMAIL_TRIAGE=openai:gpt-4o-mini
# AI_ROLE_SIGNAL_INTERPRETATION=ollama:mistral
# AI_ROLE_MEMORY_EXTRACTION=openai:gpt-4o-mini
# AI_ROLE_VALIDITY_CHECK=openai:gpt-4o-mini

# Django settings
DJANGO_SECRET_KEY=dev-secret-change-me-in-production
DEBUG=true

# Server
API_PORT=8000

# Memory settings
MEMORY_SHORT_TERM_LIMIT=20

# ============================================================================
# Emotion Engine
# ============================================================================

EMOTION_DECAY_RATE=0.02
EMOTION_MOOD_SHIFT_RATE=0.01

# ============================================================================
# Contextual Memory (Optional)
# ============================================================================

CHROMA_PERSIST_DIR=data/chromadb
CONSOLIDATION_INTERVAL=300
MEMORY_DECAY_RATE=0.95
MEMORY_MIN_IMPORTANCE=0.1
MEMORY_RETRIEVAL_SOUVENIRS=5
MEMORY_RETRIEVAL_CONNAISSANCES=10
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
HAIKU_MODEL=claude-haiku-4-5-20251001

# ============================================================================
# Modules (Optional)
# ============================================================================

# Scheduler
CRON_TICK_INTERVAL=60

# Telegram Bot (Optional)
TELEGRAM_TOKEN=

# Email Module (Optional)
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# RSS Module (Optional)
# Format: comma-separated "Name|url" pairs
# Example: Tech News|https://example.com/rss,Gaming|https://other.com/feed
RSS_FEEDS=
RSS_POLL_INTERVAL=600

# Conscience Layer
CONSCIENCE_DECISION_INTERVAL=30
CONSCIENCE_COOLDOWN_SECONDS=300
CONSCIENCE_ACT_THRESHOLD=0.5
