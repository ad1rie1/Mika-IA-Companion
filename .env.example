# ============================================================================
#  .env — infrastructure uniquement
# ============================================================================
#
#  Tout ce qui est applicatif se configure dans le tableau de bord
#  (http://localhost:8000/gestion/ → Configuration) et vit dans la base :
#  providers IA et leurs clés, modèles déclarés, mapping des rôles, délais
#  d'appel, cadences des boucles, réglages mémoire / émotion / conscience /
#  projets, comptes email, flux RSS, jeton Telegram.
#
#  Ce fichier ne garde que ce dont Django a besoin *avant* qu'une base de
#  données existe. Aucune variable ci-dessous n'a de doublon dans le
#  registre de configuration — un réglage déclaré deux fois dérive.
#
#  Premier démarrage : lancer le backend, ouvrir /gestion/ → Configuration,
#  puis dans l'ordre
#    1. IA · Claude    — coller une clé API (sk-ant-api…) ; un token OAuth
#                        de Claude.ai n'est PAS accepté
#    2. IA · Modèles   — déclarer un modèle (nom interne + provider + id)
#    3. IA · Rôles     — associer au moins `conversation` à ce nom interne
#  Tant que l'étape 3 n'est pas faite, chaque tour répond
#  « Mon IA n'a pas de modèle associé ».
#
# ============================================================================

# ── Django ──────────────────────────────────────────────────────────────────

DEBUG=true
DJANGO_SECRET_KEY=dev-secret-change-me
# Clé Fernet (32 octets base64-urlsafe) chiffrant chaque valeur `sensitive`
# du registre (clés de providers, jeton Telegram…). Lue directement dans
# l'environnement par configs/secrets.py. Absente = dérivée de
# DJANGO_SECRET_KEY : la poser découple les deux, pour que tourner la clé de
# session ne rende pas chaque secret stocké indéchiffrable. Générer avec :
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Une valeur mal formée est refusée au démarrage.
# CONFIG_ENCRYPTION_KEY=
TIME_ZONE=Europe/Paris

# ── Serveur ─────────────────────────────────────────────────────────────────

# Boucle locale par défaut : le tableau de bord lit toutes les conversations
# et édite les clés des providers. API_HOST=0.0.0.0 expose au réseau local —
# run.py émet alors un avertissement SECURITY: si DASHBOARD_REQUIRE_AUTH=0.
API_HOST=127.0.0.1
API_PORT=8000

# Validation de l'en-tête Host. Jamais `*`. Par défaut les noms de boucle
# locale réellement servis, plus le nom/IP de la machine si API_HOST n'est
# pas loopback. À renseigner derrière un reverse proxy.
# ALLOWED_HOSTS=localhost,127.0.0.1

VTUBER_NAME=Mika

# ── Authentification ────────────────────────────────────────────────────────

# Exige un compte *staff* authentifié sur tout /gestion/. Désactivé par
# défaut : une installation neuve n'a pas encore de superutilisateur, et
# verrouiller le propriétaire dehors avant `createsuperuser` est pire que
# l'exposition en boucle locale.
DASHBOARD_REQUIRE_AUTH=false

# Refuse les connexions WebSocket anonymes côté frontend.
CONSUMER_REQUIRE_AUTH=true

LOGIN_URL=/admin/login/

# person_id supplémentaires traités comme l'opérateur (ex. votre tg_<id>).
# Les comptes authentifiés (user_*) le sont déjà.
# OWNER_PERSON_IDS=

# ── CORS / CSRF ─────────────────────────────────────────────────────────────

# Non wildcardé : sinon n'importe quelle page visitée lit l'historique et
# réécrit la configuration en cross-origin.
CORS_ALLOW_ALL_ORIGINS=false
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Obligatoire — le frontend s'authentifie par cookie de session.
CORS_ALLOW_CREDENTIALS=true
# Par défaut identique à CORS_ALLOWED_ORIGINS.
# CSRF_TRUSTED_ORIGINS=http://localhost:3000
SESSION_COOKIE_SAMESITE=Lax
# Par défaut identique à SESSION_COOKIE_SAMESITE.
# CSRF_COOKIE_SAMESITE=Lax

# Cookies `Secure` : renvoyés par le navigateur uniquement en TLS. Faux par
# défaut — l'installation type sert http://127.0.0.1:8000, où un cookie Secure
# ne reviendrait jamais (chaque connexion échouerait sans rien dire). Passer
# les deux à true derrière TLS.
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false
# Derrière un reverse proxy qui termine le TLS, Django ne voit que du HTTP :
# `is_secure()` répond faux, ce qui casse le contrôle d'origine CSRF et le
# retour après écriture. true = faire confiance à X-Forwarded-Proto —
# seulement si le proxy est l'unique chemin vers ce processus et réécrit
# l'en-tête, sinon n'importe quel client la forge.
BEHIND_TLS_PROXY=false

# ── Base de données ─────────────────────────────────────────────────────────

# Délai d'attente SQLite (secondes) sous écriture concurrente permanente.
DB_LOCK_TIMEOUT=30

# ── Stockage sur disque ─────────────────────────────────────────────────────

CHROMA_PERSIST_DIR=data/chromadb
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
# Refuser de demarrer si le magasin vectoriel ne se charge pas (defaut : 1).
# Sans lui : ni souvenirs, ni connaissances, ni engagements, ni fiches de
# personnes, pour toute la duree du processus. Mettre 0 pour demarrer quand
# meme en memoire basique, en connaissance de cause.
MEMORY_REQUIRE_VECTOR_STORE=1
# Espace confiné des modules écrits par l'IA.
FORGE_DIR=data/forge_modules

# ── Quotas de jetons par rôle ───────────────────────────────────────────────
#
# Lus par nom calculé (AI_QUOTA_ROLE_<ROLE>_DAILY / _MONTHLY) dans
# ai/quota.py, d'où leur présence ici plutôt que dans le registre.
# 0 = illimité. Les onze rôles d'`AIRole`, chacun avec sa paire :
#
# AI_QUOTA_ROLE_CONVERSATION_DAILY=0
# AI_QUOTA_ROLE_CONVERSATION_MONTHLY=0
# AI_QUOTA_ROLE_CONVERSATION_TOOLS_DAILY=0
# AI_QUOTA_ROLE_CONVERSATION_TOOLS_MONTHLY=0
# AI_QUOTA_ROLE_EMAIL_TRIAGE_DAILY=0
# AI_QUOTA_ROLE_EMAIL_TRIAGE_MONTHLY=0
# AI_QUOTA_ROLE_SIGNAL_INTERPRETATION_DAILY=0
# AI_QUOTA_ROLE_SIGNAL_INTERPRETATION_MONTHLY=0
# AI_QUOTA_ROLE_MEMORY_EXTRACTION_DAILY=0
# AI_QUOTA_ROLE_MEMORY_EXTRACTION_MONTHLY=0
# AI_QUOTA_ROLE_VALIDITY_CHECK_DAILY=0
# AI_QUOTA_ROLE_VALIDITY_CHECK_MONTHLY=0
# AI_QUOTA_ROLE_VISION_CAPTION_DAILY=0
# AI_QUOTA_ROLE_VISION_CAPTION_MONTHLY=0
# AI_QUOTA_ROLE_INNER_VOICE_DAILY=0
# AI_QUOTA_ROLE_INNER_VOICE_MONTHLY=0
# AI_QUOTA_ROLE_PREPARATION_DAILY=0
# AI_QUOTA_ROLE_PREPARATION_MONTHLY=0
# AI_QUOTA_ROLE_COMPACTION_DAILY=0
# AI_QUOTA_ROLE_COMPACTION_MONTHLY=0
# La boucle d'outils la plus chère (atelier des projets) :
# AI_QUOTA_ROLE_PROJECT_WORK_DAILY=0
# AI_QUOTA_ROLE_PROJECT_WORK_MONTHLY=0
