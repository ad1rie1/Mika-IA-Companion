# Mika v2 — le serveur (HTTP, WebSocket, inspecteur).
# Installation et exploitation : deploy/README.md
[Unit]
Description=Mika v2
Documentation=file:/opt/mika/backendv2/deploy/README.md
# MariaDB (si ses bases y sont, deploy/README.md) démarre avant elle
After=network-online.target mariadb.service
Wants=network-online.target

[Service]
Type=simple
User=mika
Group=mika
WorkingDirectory=/opt/mika/backendv2
# MIKA_SECRET_KEY (facultatif), MIKA_DATABASE_URL (ses bases sur MariaDB), HF_HOME…
EnvironmentFile=-/etc/mika/mika.env
Environment=HF_HOME=/var/lib/mika/cache/huggingface
# les dossiers d'appel de Claude Code (prompts privés, jetons de session) : en mémoire, privés, jamais sauvegardés
RuntimeDirectory=mika
RuntimeDirectoryMode=0700
Environment=XDG_RUNTIME_DIR=/run/mika
# derrière un mandataire TLS : ajouter --origin https://… --behind-proxy (deploy/README.md)
ExecStart=/opt/mika/backendv2/.venv/bin/python -m mika --data /var/lib/mika serve --host 127.0.0.1 --port 8001
Restart=on-failure
RestartSec=5
# SIGTERM : 20 s pour les connexions, puis le noyau s'arrête (voies, processus, journal fermé)
KillSignal=SIGTERM
TimeoutStopSec=60

# Durcissement. Pas de RestrictNamespaces ni de PrivateUsers : bubblewrap (la
# Forge, les ateliers) a besoin des espaces de noms utilisateur. Pas de
# ProtectKernelTunables non plus : il masque une partie de /proc, et le noyau
# refuse alors à bubblewrap de monter le /proc du bac à sable (vérifié).
# Pas de NoNewPrivileges non plus : le réseau à part des cages (le web par
# DuckDuckGo, les commandes approuvées des ateliers) passe par pasta, qui entre
# dans son domaine SELinux (pasta_t) ; sous no_new_privs, la cage ne monte plus
# (« bwrap: setting up uid map: Operation not permitted », vérifié sur Fedora 44).
# Ce que la cage exécute reste sans privilèges nouveaux : bubblewrap pose
# no_new_privs lui-même.
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/mika
PrivateTmp=yes
PrivateDevices=yes
# pasta ouvre /dev/net/tun, que PrivateDevices retire du /dev privé : lui seul est rendu
BindPaths=/dev/net/tun
DeviceAllow=/dev/net/tun rw
ProtectKernelModules=yes
ProtectControlGroups=yes
LockPersonality=yes
RestrictRealtime=yes
UMask=0077

[Install]
WantedBy=multi-user.target
