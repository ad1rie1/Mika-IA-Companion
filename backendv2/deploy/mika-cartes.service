# Mika v2 — les cartes se refont sur le serveur (voir mika-cartes.timer, ADR 0295) : les tuiles de la France et leurs
# polices, puis l'index des lieux tiré de l'extrait OpenStreetMap du jour, puis les départements de DATAtourisme.
# Sans risque serveur en marche : une archive, un index ou une base neufs ne remplacent l'ancien qu'entiers.
# À la main : sudo systemctl start mika-cartes.service ; ce qu'il a fait : journalctl -u mika-cartes.
[Unit]
Description=Mika v2 — cartes, lieux et données touristiques
After=mika.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=mika
Group=mika
WorkingDirectory=/opt/mika/backendv2
EnvironmentFile=-/etc/mika/mika.env
# les tuiles et leurs polices : une tuile en échec laisse l'archive d'avant, l'index se refait quand même
ExecStart=-/opt/mika/backendv2/.venv/bin/python -m mika --data /var/lib/mika carte extraire --zone france --zoom 15
ExecStart=-/opt/mika/backendv2/.venv/bin/python -m mika --data /var/lib/mika carte polices
# l'extrait OpenStreetMap du jour (~5 Go, Geofabrik le refait chaque nuit), gardé : « mika carte lieux » le reprend
ExecStart=/usr/bin/curl -fsSL --retry 3 --retry-delay 60 -o /var/lib/mika/cartes/france-latest.osm.pbf.part https://download.geofabrik.de/europe/france-latest.osm.pbf
ExecStart=/usr/bin/mv -f /var/lib/mika/cartes/france-latest.osm.pbf.part /var/lib/mika/cartes/france-latest.osm.pbf
ExecStart=/opt/mika/backendv2/.venv/bin/python -m mika --data /var/lib/mika carte lieux --depuis cartes/france-latest.osm.pbf
# sans clé ni département réglés, rien à faire : son refus ne fait pas échouer le reste
ExecStart=-/opt/mika/backendv2/.venv/bin/python -m mika --data /var/lib/mika carte tourisme
TimeoutStartSec=6h
Nice=19
IOSchedulingClass=idle
# l'index se construit à côté de Mika : borné, il cède plutôt qu'elle
MemoryHigh=1500M
MemoryMax=2500M
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/mika
PrivateTmp=yes
UMask=0077
