    "version": "0.2.0",
    "configurations": [

        {
            "name": "Mika v2 (mika serve)",
            "type": "debugpy",
            "request": "launch",
            "module": "mika",
            "args": ["--data", "data/v2", "serve", "--port", "8001"],
            "cwd": "${workspaceFolder}/backendv2",
            "python": "${workspaceFolder}/backendv2/.venv/bin/python",
            "console": "integratedTerminal",
            "justMyCode": false,
            "autoStartBrowser": false
        }
    ]
}
