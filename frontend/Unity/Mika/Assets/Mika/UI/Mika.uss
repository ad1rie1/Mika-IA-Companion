/* L'interface du monde : sobre, lisible sur la scène, en français. */
:root {
    --ink: rgb(245, 242, 250);
    --ink-dim: rgba(245, 242, 250, 0.7);
    --panel: rgba(18, 16, 28, 0.72);
    --panel-strong: rgba(18, 16, 28, 0.9);
    --accent: rgb(255, 150, 200);
    --ok: rgb(140, 220, 160);
    --warn: rgb(255, 200, 120);
    --bad: rgb(255, 130, 130);
}

.hud { position: absolute; left: 0; top: 0; right: 0; bottom: 0; color: var(--ink); font-size: 15px; }
.status { position: absolute; left: 14px; top: 12px; flex-direction: row; }
.pill { background-color: var(--panel); border-radius: 12px; padding: 4px 10px; margin-right: 8px; font-size: 12px; color: var(--ink-dim); }
.pill.ok { color: var(--ok); }
.pill.warn { color: var(--warn); }
.pill.bad { color: var(--bad); }

.crosshair { position: absolute; left: 50%; top: 50%; width: 6px; height: 6px; margin-left: -3px; margin-top: -3px; border-radius: 3px; background-color: rgba(255, 255, 255, 0.75); }
.focus { position: absolute; left: 0; right: 0; top: 54%; align-items: center; }
.focus-label { background-color: var(--panel); border-radius: 8px; padding: 4px 12px; -unity-font-style: bold; }
.focus-hint { margin-top: 4px; color: var(--ink-dim); font-size: 13px; }

.menu { position: absolute; left: 52%; top: 40%; min-width: 260px; background-color: var(--panel-strong); border-radius: 10px; padding: 8px; }
.menu-title { -unity-font-style: bold; margin: 2px 6px 6px 6px; color: var(--accent); }
.menu-item { margin: 2px; padding: 6px 10px; border-radius: 6px; background-color: rgba(255, 255, 255, 0.06); border-width: 0; color: var(--ink); -unity-text-align: middle-left; }
.menu-item:hover { background-color: rgba(255, 150, 200, 0.28); }

.toasts { position: absolute; left: 0; right: 0; bottom: 120px; align-items: center; }
.toast { background-color: var(--panel-strong); border-radius: 8px; padding: 6px 14px; margin-top: 4px; color: var(--warn); max-width: 640px; white-space: normal; }

.request { position: absolute; left: 50%; top: 22%; width: 420px; margin-left: -210px; background-color: var(--panel-strong); border-radius: 12px; padding: 14px; }
.request-text { white-space: normal; margin-bottom: 10px; font-size: 16px; }
.request-buttons { flex-direction: row; justify-content: flex-end; }
.btn { padding: 6px 14px; border-radius: 8px; border-width: 0; margin-left: 8px; background-color: rgba(255, 255, 255, 0.12); color: var(--ink); }
.btn.primary { background-color: rgba(255, 150, 200, 0.55); }

.chat { position: absolute; left: 14px; bottom: 14px; width: 460px; }
.chat-log { max-height: 260px; overflow: hidden; justify-content: flex-end; flex-shrink: 0; }
.chat-line { white-space: normal; background-color: var(--panel); border-radius: 8px; padding: 5px 10px; margin-top: 4px; }
.chat-line.mika { border-left-width: 3px; border-left-color: var(--accent); }
.chat-line.me { color: var(--ink-dim); }

/* La fenêtre de saisie (Entrée / T) : le champ par défaut de UI Toolkit est blanc, le texte aussi — on le
   remplace par du verre fumé translucide, le texte clair reste lisible et la pièce se voit derrière. */
.chat-input { margin-top: 6px; }
.chat-input #unity-text-input, .settings #unity-text-input {
    background-color: rgba(14, 12, 24, 0.45);
    border-width: 1px; border-radius: 10px; border-color: rgba(255, 255, 255, 0.18);
    padding: 7px 12px; color: var(--ink); font-size: 15px;
    --unity-cursor-color: rgb(255, 170, 210);
    --unity-selection-color: rgba(255, 150, 200, 0.35);
}
.chat-input #unity-text-input:focus, .settings #unity-text-input:focus { border-color: rgba(255, 150, 200, 0.75); }
.chat-input #unity-text-input .unity-text-element, .settings #unity-text-input .unity-text-element { color: var(--ink); text-shadow: 0 1px 2px rgba(0, 0, 0, 0.6); }
.chat-input .unity-base-text-field__input--placeholder, .chat-input .unity-base-text-field__input--placeholder .unity-text-element { color: rgba(245, 242, 250, 0.45); }
.settings TextField > Label, .settings Toggle > Label { color: var(--ink-dim); min-width: 70px; }

.subtitle { position: absolute; left: 0; right: 0; bottom: 64px; align-items: center; }
.subtitle-text { background-color: var(--panel-strong); border-radius: 10px; padding: 8px 16px; max-width: 760px; white-space: normal; font-size: 18px; -unity-text-align: middle-center; }

.settings { position: absolute; right: 14px; top: 44px; width: 360px; background-color: var(--panel-strong); border-radius: 12px; padding: 12px; }
.settings-title { -unity-font-style: bold; color: var(--accent); margin-bottom: 6px; }
.settings-note { white-space: normal; color: var(--ink-dim); font-size: 12px; margin-top: 6px; }
.hidden { display: none; }
